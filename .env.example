# 复制此文件为 .env 并填入实际配置
# 注意：.env 文件已被 .gitignore 忽略，不会提交到仓库

# DeepSeek API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# PostgreSQL 数据库连接串
DB_URI=postgresql://postgres:password@localhost:5432/chat_agent

# OpenSandbox 沙箱配置
OPEN_SANDBOX_API_KEY=your_sandbox_api_key_here
OPEN_SANDBOX_DOMAIN=localhost:8080
SANDBOX_IMAGE=opensandbox/code-interpreter:v1.1.0
